# Copy to .env.local and fill in from your Supabase project.
#
# Settings → API keys:
#   VITE_SUPABASE_PUBLISHABLE_KEY  →  "Copy publishable key"  (sb_publishable_…)
#
# Use the PUBLISHABLE key. Never the "secret" or "service" keys — those bypass
# row-level security entirely, and anything in a VITE_ variable is compiled
# into the JavaScript every visitor downloads.
#
# The publishable key is meant to be public; row-level security is what protects
# the data, not the secrecy of this key.
#
# Leave these unset and the app still runs — it just falls back to
# localStorage-only, with no sync.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
